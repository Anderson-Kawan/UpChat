<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Upchat</title>

    <meta name="description"
          content="Upchat: soluções para atendimento, CRM, vendas e gestão para provedores de internet." />

    <meta name="theme-color" content="#0B172B" />
    <meta name="author" content="Upchat" />

    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />

    <!-- Fontes -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />

    <!-- CSS principal -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <!-- CSS do Header -->
    <link rel="stylesheet"
          href="~/css/header.css"
          asp-append-version="true" />

    <!-- CSS do Footer -->
    <link rel="stylesheet"
          href="~/css/footer.css"
          asp-append-version="true" />
          
    <!-- Estilos específicos de cada página -->
    @await RenderSectionAsync("Styles", required: false)

</head>

<body>

    <!-- Cabeçalho -->
    <partial name="Header" />

    <!-- Conteúdo principal -->
    <main role="main">

        @RenderBody()

    </main>

    <!-- Rodapé -->
    <partial name="Footer" />

    <!-- JavaScript principal -->
    <script src="~/js/site.js"
            asp-append-version="true"></script>

    <!-- Scripts específicos de cada página -->
    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>
